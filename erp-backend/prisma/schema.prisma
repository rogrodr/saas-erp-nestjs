generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GERENTE
  FUNCIONARIO
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

enum StatusPedido {
  PENDENTE
  FATURADO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum TipoPreco {
  COMPRA
  VENDA
}

enum AcaoAuditoria {
  CRIAR
  ATUALIZAR
  DELETAR
  ACESSO
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String?
  createdAt DateTime @default(now())

  usuarios        Usuario[]
  clientes        Cliente[]
  produtos        Produto[]
  vendas          Venda[]
  historicoPrecos HistoricoPreco[]
  fornecedores    Fornecedor[]
  compras         Compra[]
  contasPagar     ContaPagar[]
  contasReceber   ContaReceber[]
  movimentacoes   MovimentacaoEstoque[]
  auditorias      Auditoria[]
}

model Usuario {
  id                Int           @id @default(autoincrement())
  nome              String
  email             String        @unique
  senha             String
  role              Role          @default(FUNCIONARIO)
  status            StatusUsuario @default(ATIVO)
  
  empresaId         Int
  empresa           Empresa       @relation(fields: [empresaId], references: [id])
  
  resetToken        String?
  resetTokenExpires DateTime?
  
  createdAt         DateTime      @default(now())

  movimentacoes     MovimentacaoEstoque[]
  auditorias        Auditoria[]
}

model Cliente {
  id        Int     @id @default(autoincrement())
  nome      String
  cpf       String? @unique
  
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  enderecos     EnderecoCliente[]
  contatos      ContatoCliente[]
  vendas        Venda[]
  contasReceber ContaReceber[]
}

model EnderecoCliente {
  id          Int     @id @default(autoincrement())
  logradouro  String
  numero      String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  principal   Boolean @default(true)
  
  clienteId   Int
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model ContatoCliente {
  id        Int     @id @default(autoincrement())
  nome      String
  telefone  String?
  email     String?
  principal Boolean @default(true)
  
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model Produto {
  id         Int     @id @default(autoincrement())
  nome       String
  preco      Float
  sku        String?
  categoria  String?
  estoque    Int     @default(0)
  estoqueMin Int     @default(5) 
  ativo      Boolean @default(true)

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  vendaItems      VendaItem[]
  compraItems     CompraItem[]
  historicoPrecos HistoricoPreco[]
  movimentacoes   MovimentacaoEstoque[]
}

model Fornecedor {
  id       Int     @id @default(autoincrement())
  nome     String
  cnpj     String? @unique
  telefone String?
  email    String?

  endereco String?
  numero   String?
  bairro   String?
  cidade   String?
  estado   String?
  cep      String?

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compras Compra[]
}

model Venda {
  id        Int          @id @default(autoincrement())
  total     Float
  status    StatusPedido @default(PENDENTE)
  desconto  Float        @default(0.0)
  createdAt DateTime     @default(now())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  itens           VendaItem[]
  contasReceber   ContaReceber[]
  historicoPrecos HistoricoPreco[]
}

model VendaItem {
  id Int @id @default(autoincrement())

  vendaId   Int
  produtoId Int

  quantidade Int
  preco      Float

  venda   Venda   @relation(fields: [vendaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
}

model Compra {
  id        Int      @id @default(autoincrement())
  total     Float
  createdAt DateTime @default(now())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  itens           CompraItem[]
  historicoPrecos HistoricoPreco[]
}

model CompraItem {
  id Int @id @default(autoincrement())

  compraId  Int
  produtoId Int

  quantidade Int
  preco      Float

  compra  Compra  @relation(fields: [compraId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
}

model ContaPagar {
  id Int @id @default(autoincrement())

  descricao  String
  valor      Float
  vencimento DateTime
  pago       Boolean  @default(false)

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

model ContaReceber {
  id Int @id @default(autoincrement())

  descricao  String
  valor      Float
  vencimento DateTime
  pago       Boolean  @default(false)

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id])
}

model HistoricoPreco {
  id Int @id @default(autoincrement())

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])

  preco Float
  tipo  TipoPreco

  compraId Int?
  compra   Compra? @relation(fields: [compraId], references: [id])

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id])

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())
}

model MovimentacaoEstoque {
  id         Int              @id @default(autoincrement())
  tipo       TipoMovimentacao
  quantidade Int
  motivo     String?
  createdAt  DateTime         @default(now())

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])
  
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Auditoria {
  id              Int           @id @default(autoincrement())
  entidade        String
  entidadeId      Int?
  acao            AcaoAuditoria
  dadosAnteriores Json?
  dadosNovos      Json?
  createdAt       DateTime      @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}